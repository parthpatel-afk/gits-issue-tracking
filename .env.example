# Copy to .env.local and fill in your own Supabase project values.
# The anon key is safe to expose in a client bundle; it is governed by
# Row Level Security. Never give a service-role key a VITE_ prefix --
# Vite inlines every VITE_* variable it finds referenced in client source,
# which would publish the key in your JS bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
